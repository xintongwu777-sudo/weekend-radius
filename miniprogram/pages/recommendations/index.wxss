.recommendations-page { padding-bottom: 70rpx; }
.summary-row { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; padding: 20rpx 0; color: #6f756f; font-size: 24rpx; border-bottom: 1rpx solid #ded8ce; }
.edit-link { color: #e9663d; font-weight: 600; }
.result-list { display: flex; flex-direction: column; gap: 30rpx; margin-top: 34rpx; }
.event-card { overflow: hidden; }
.image-wrap { position: relative; height: 430rpx; }
.event-image { width: 100%; height: 100%; }
.match-position { position: absolute; top: 22rpx; right: 22rpx; }
.relaxed-badge { position: absolute; bottom: 20rpx; left: 20rpx; padding: 10rpx 16rpx; color: #fffdf8; background: rgba(31,42,36,.8); border-radius: 999rpx; font-size: 20rpx; }
.source-badge { position: absolute; top: 22rpx; left: 22rpx; padding: 10rpx 16rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 650; }
.verified-source { color: #405046; background: #d7dfc9; }
.mock-source { color: #fffdf8; background: rgba(31,42,36,.72); }
.event-content { padding: 28rpx; }
.event-category { display: block; color: #e9663d; font-size: 22rpx; font-weight: 650; letter-spacing: 1rpx; }
.event-title { display: block; margin-top: 12rpx; font-size: 38rpx; font-weight: 680; line-height: 1.3; }
.event-meta { display: flex; flex-wrap: wrap; gap: 8rpx 12rpx; margin-top: 16rpx; color: #5e655f; font-size: 23rpx; }
.event-review { display: block; margin-top: 14rpx; color: #a65335; font-size: 24rpx; font-weight: 650; }
.event-reason { display: block; margin-top: 22rpx; padding: 20rpx; color: #405046; background: rgba(169,190,165,.16); border-radius: 18rpx; font-size: 25rpx; line-height: 1.5; }
.card-footer { display: flex; justify-content: space-between; margin-top: 24rpx; padding-top: 20rpx; color: #6f756f; border-top: 1rpx solid #eee8df; font-size: 23rpx; }
.open-arrow { color: #1f2a24; font-size: 30rpx; }
.empty-action { margin-top: 32rpx; }
