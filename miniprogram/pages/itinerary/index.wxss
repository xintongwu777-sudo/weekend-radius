.itinerary-page { padding-top: 28rpx; }
.summary-card { margin-top: 34rpx; padding: 30rpx; }
.summary-main { display: flex; align-items: center; justify-content: space-between; }
.summary-time { font-size: 38rpx; font-weight: 680; }
.pace-pill { padding: 10rpx 18rpx; color: #405046; background: #d7dfc9; border-radius: 999rpx; font-size: 22rpx; }
.summary-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 30rpx; padding-top: 26rpx; border-top: 1rpx solid #eee8df; }
.summary-value, .summary-label { display: block; }
.summary-value { font-size: 28rpx; font-weight: 650; }
.summary-label { margin-top: 8rpx; color: #8b8f8b; font-size: 20rpx; }
.timeline { margin-top: 48rpx; }
.add-gap-card { display: flex; align-items: center; gap: 18rpx; margin: 0 0 26rpx 132rpx; padding: 20rpx 22rpx; background: rgba(169,190,165,.16); border: 2rpx dashed #a9bea5; border-radius: 22rpx; }
.timeline-add { margin-top: 24rpx; margin-bottom: 2rpx; }
.add-gap-plus { display: flex; flex: 0 0 48rpx; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; color: #fffdf8; background: #789174; border-radius: 50%; font-size: 30rpx; font-weight: 500; }
.add-gap-copy { flex: 1; min-width: 0; }
.add-gap-title, .add-gap-meta { display: block; }
.add-gap-title { color: #405046; font-size: 25rpx; font-weight: 680; }
.add-gap-meta { margin-top: 5rpx; color: #7e867f; font-size: 20rpx; }
.add-gap-arrow { color: #789174; font-size: 28rpx; }
.transport-row { display: grid; grid-template-columns: 94rpx 1fr; min-height: 62rpx; }
.transport-line { margin-left: 28rpx; padding-left: 34rpx; color: #8b8f8b; border-left: 2rpx dashed #c9c2b8; font-size: 21rpx; line-height: 62rpx; }
.node-row { display: grid; grid-template-columns: 94rpx 38rpx 1fr; align-items: start; }
.node-time { display: flex; flex-direction: column; padding-top: 10rpx; font-size: 24rpx; font-weight: 650; }
.end-time { margin-top: 7rpx; color: #9a9e9a; font-size: 20rpx; font-weight: 400; }
.timeline-rail { display: flex; justify-content: center; min-height: 100%; }
.timeline-dot { width: 18rpx; height: 18rpx; margin-top: 17rpx; background: #789174; border: 5rpx solid #f6f1e8; border-radius: 50%; box-shadow: 0 0 0 2rpx #789174; }
.anchor-dot { width: 24rpx; height: 24rpx; background: #e9663d; box-shadow: 0 0 0 3rpx #e9663d; }
.node-card { margin-bottom: 4rpx; overflow: hidden; background: #fffdf8; border-radius: 28rpx; }
.anchor-card { background: #f8ddcf; border: 2rpx solid #e9663d; }
.node-image { width: 100%; height: 250rpx; }
.anchor-card .node-image { height: 310rpx; }
.node-content { padding: 24rpx; }
.node-top { display: flex; justify-content: space-between; align-items: center; }
.node-category-row { display: flex; align-items: center; gap: 10rpx; }
.node-category { color: #e9663d; font-size: 20rpx; font-weight: 700; letter-spacing: 1rpx; }
.live-data-badge { padding: 6rpx 10rpx; color: #405046; background: #d7dfc9; border-radius: 999rpx; font-size: 17rpx; font-weight: 650; letter-spacing: 0; }
.node-cost { font-size: 22rpx; font-weight: 600; }
.node-name { display: block; margin-top: 10rpx; font-size: 34rpx; font-weight: 680; line-height: 1.3; }
.node-address { display: block; margin-top: 10rpx; color: #6f756f; font-size: 22rpx; line-height: 1.5; }
.node-review { display: block; margin-top: 10rpx; color: #a65335; font-size: 22rpx; font-weight: 650; }
.node-navigation { display: inline-flex; margin-top: 14rpx; padding: 10rpx 16rpx; color: #405046; background: #d7dfc9; border-radius: 999rpx; font-size: 21rpx; font-weight: 650; }
.node-reason { display: block; margin-top: 16rpx; color: #505951; font-size: 23rpx; line-height: 1.55; }
.replace-link, .anchor-lock { margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(31,42,36,.1); font-size: 23rpx; }
.replace-link { color: #e9663d; font-weight: 650; }
.anchor-lock { color: #7b665c; }
.demo-note { margin: 46rpx 0 10rpx 132rpx; color: #929691; font-size: 20rpx; line-height: 1.6; }
.live-note { padding: 18rpx 20rpx; color: #55645a; background: rgba(169,190,165,.16); border-radius: 18rpx; }
.sheet-mask { position: fixed; z-index: 80; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; background: rgba(20,29,24,.48); }
.replace-sheet { width: 100%; max-height: 78vh; padding: 18rpx 32rpx calc(30rpx + env(safe-area-inset-bottom)); background: #f6f1e8; border-radius: 38rpx 38rpx 0 0; }
.sheet-handle { width: 78rpx; height: 8rpx; margin: 0 auto 28rpx; background: #c7c1b8; border-radius: 999rpx; }
.sheet-eyebrow { color: #e9663d; font-size: 19rpx; font-weight: 700; letter-spacing: 2rpx; }
.sheet-title { display: block; margin-top: 10rpx; font-size: 40rpx; font-weight: 700; }
.sheet-copy { display: block; margin-top: 12rpx; color: #6f756f; font-size: 23rpx; }
.candidate-list { max-height: 650rpx; margin-top: 26rpx; }
.candidate-card { display: flex; gap: 22rpx; margin-bottom: 16rpx; padding: 18rpx; background: #fffdf8; border-radius: 24rpx; }
.candidate-image { flex: 0 0 180rpx; width: 180rpx; height: 150rpx; border-radius: 18rpx; }
.candidate-content { flex: 1; min-width: 0; }
.candidate-top, .candidate-deltas { display: flex; justify-content: space-between; gap: 12rpx; }
.candidate-tag { color: #e9663d; font-size: 20rpx; font-weight: 650; }
.candidate-category { color: #8b8f8b; font-size: 20rpx; }
.candidate-name { display: block; margin-top: 12rpx; font-size: 30rpx; font-weight: 650; }
.candidate-review { display: block; margin-top: 10rpx; color: #a65335; font-size: 21rpx; font-weight: 650; }
.candidate-deltas { margin-top: 16rpx; color: #6f756f; font-size: 20rpx; }
.no-candidate { padding: 50rpx 20rpx; color: #8b8f8b; text-align: center; }
.skip-button { height: 76rpx; margin-top: 16rpx; color: #5e655f; background: transparent; border: 1rpx solid #cfc8bd; border-radius: 38rpx; font-size: 25rpx; line-height: 76rpx; }
