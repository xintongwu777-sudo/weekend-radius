.detail-page { min-height: 100vh; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); background: #f6f1e8; }
.detail-hero { position: relative; height: 570rpx; margin: 24rpx 24rpx 0; overflow: hidden; border-radius: 34rpx; }
.detail-image { width: 100%; height: 100%; }
.category-pill { position: absolute; bottom: 24rpx; left: 24rpx; padding: 12rpx 22rpx; color: #fffdf8; background: #1f2a24; border-radius: 999rpx; font-size: 23rpx; }
.detail-content { padding: 34rpx 34rpx 60rpx; }
.district { display: block; color: #e9663d; font-size: 23rpx; font-weight: 650; letter-spacing: 1rpx; }
.detail-title { display: block; margin-top: 16rpx; font-size: 54rpx; font-weight: 720; line-height: 1.18; }
.fact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rpx; margin-top: 34rpx; overflow: hidden; background: #ded8ce; border: 1rpx solid #ded8ce; border-radius: 26rpx; }
.fact { display: flex; flex-direction: column; gap: 10rpx; padding: 26rpx; background: #fffdf8; }
.fact-label { color: #8b8f8b; font-size: 19rpx; letter-spacing: 2rpx; }
.match-panel { display: flex; align-items: center; gap: 32rpx; margin-top: 30rpx; padding: 30rpx; background: #d7dfc9; border-radius: 28rpx; }
.match-score { min-width: 150rpx; }
.match-number { font-size: 56rpx; font-weight: 750; }
.match-unit { display: block; font-size: 21rpx; }
.reason-line { display: block; margin: 8rpx 0; font-size: 24rpx; line-height: 1.5; }
.article-section { margin-top: 48rpx; }
.article-title, .article-copy { display: block; }
.article-title { font-size: 32rpx; font-weight: 680; }
.article-copy { margin-top: 16rpx; color: #5e655f; line-height: 1.75; }
.venue-address { display: block; margin-top: 10rpx; color: #7a807a; font-size: 24rpx; line-height: 1.6; }
.map-button { height: 78rpx; margin: 24rpx 0 0; color: #fffdf8; background: #1f2a24; border-radius: 39rpx; font-size: 25rpx; line-height: 78rpx; }
.disabled-map { color: #969b96; background: #e6e1d8; }
.source-note { display: flex; flex-direction: column; gap: 10rpx; margin-top: 52rpx; padding-top: 28rpx; color: #8b8f8b; border-top: 1rpx solid #ded8ce; font-size: 21rpx; }
.verified-note { padding: 24rpx; color: #55645a; background: rgba(169,190,165,.15); border: none; border-radius: 22rpx; }
.source-link { margin-top: 8rpx; color: #e9663d; font-weight: 650; }
