.home { min-height: 100vh; background: #f6f1e8; }
.hero { position: relative; height: 72vh; min-height: 900rpx; overflow: hidden; border-radius: 0 0 48rpx 48rpx; }
.hero-image { width: 100%; height: 100%; }
.hero-shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(31, 42, 36, 0.12); }
.brand-row { position: absolute; top: 40rpx; right: 34rpx; left: 34rpx; display: flex; justify-content: space-between; align-items: center; color: #fffdf8; }
.brand { font-size: 30rpx; font-weight: 700; letter-spacing: 2rpx; }
.city-location { display: flex; align-items: center; max-width: 360rpx; padding: 11rpx 16rpx; background: rgba(31,42,36,.28); border: 1rpx solid rgba(255,253,248,.3); border-radius: 999rpx; }
.location-dot { flex: 0 0 12rpx; width: 12rpx; height: 12rpx; margin-right: 10rpx; background: #f3c879; border-radius: 50%; }
.location-ready .location-dot { background: #cfe0c4; box-shadow: 0 0 0 5rpx rgba(207,224,196,.18); }
.city { overflow: hidden; font-size: 19rpx; letter-spacing: 1rpx; text-overflow: ellipsis; white-space: nowrap; }
.hero-copy { position: absolute; right: 42rpx; bottom: 70rpx; left: 42rpx; color: #fffdf8; }
.hero-title { display: block; font-size: 82rpx; font-weight: 720; line-height: 1.06; letter-spacing: -4rpx; }
.hero-subtitle { display: block; margin-top: 28rpx; font-size: 28rpx; }
.home-content { padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.start-button { margin-top: -80rpx; position: relative; z-index: 3; }
.location-hint { display: flex; align-items: center; gap: 18rpx; margin-top: 30rpx; padding: 22rpx 24rpx; background: rgba(169,190,165,.15); border: 1rpx solid rgba(120,145,116,.2); border-radius: 24rpx; }
.hint-icon { display: flex; flex: 0 0 48rpx; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; color: #fffdf8; background: #789174; border-radius: 50%; font-size: 27rpx; }
.hint-title, .hint-copy { display: block; }
.hint-title { color: #405046; font-size: 24rpx; font-weight: 680; }
.hint-copy { margin-top: 5rpx; color: #7e867f; font-size: 20rpx; }
.hint-arrow { margin-left: auto; color: #789174; font-size: 28rpx; }
.arrow { margin-left: 18rpx; font-size: 36rpx; }
.saved-section { margin-top: 50rpx; }
.section-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx; }
.section-title { font-size: 34rpx; font-weight: 650; }
.section-link { color: #e9663d; font-size: 25rpx; }
.saved-card { display: flex; justify-content: space-between; align-items: flex-end; padding: 30rpx; }
.saved-date, .saved-title, .saved-anchor { display: block; }
.saved-date { color: #e9663d; font-size: 23rpx; font-weight: 600; }
.saved-title { margin-top: 10rpx; font-size: 32rpx; font-weight: 650; }
.saved-anchor { margin-top: 12rpx; color: #6f756f; font-size: 23rpx; }
.saved-cost { color: #1f2a24; font-size: 25rpx; font-weight: 600; }
.promise-row { display: flex; justify-content: space-between; margin-top: 48rpx; padding: 0 12rpx; color: #6f756f; font-size: 24rpx; }
.promise-item { display: flex; flex-direction: column; gap: 8rpx; }
.promise-number { color: #e9663d; font-size: 20rpx; letter-spacing: 1rpx; }
