/* Global visual baseline. Keep this file as the single shared style entry. */
page {
  --color-bg: #f6f1e8;
  --color-surface: #fffdf8;
  --color-text: #1f2a24;
  --color-muted: #6f756f;
  --color-primary: #e9663d;
  --color-primary-dark: #cd512e;
  --color-sage: #a9bea5;
  --color-line: #ded8ce;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

view, text, image, button, scroll-view {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(180rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.page-title {
  margin-top: 14rpx;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -2rpx;
}

.title-break {
  display: block;
}

.page-subtitle {
  margin-top: 18rpx;
  color: var(--color-muted);
  font-size: 28rpx;
  line-height: 1.65;
}

.surface-card {
  background: var(--color-surface);
  border: 1rpx solid rgba(31, 42, 36, 0.06);
  border-radius: 32rpx;
  box-shadow: 0 14rpx 40rpx rgba(31, 42, 36, 0.05);
}

.sticky-actions {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(246, 241, 232, 0.96);
  border-top: 1rpx solid rgba(31, 42, 36, 0.06);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  margin: 0;
  color: #fffdf8;
  background: var(--color-primary);
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1;
  box-shadow: 0 12rpx 28rpx rgba(233, 102, 61, 0.22);
}

.primary-button:active {
  background: var(--color-primary-dark);
  transform: translateY(1rpx);
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  margin: 0;
  color: var(--color-text);
  background: transparent;
  border: 1rpx solid var(--color-line);
  border-radius: 42rpx;
  font-size: 28rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 20rpx;
  color: var(--color-muted);
  background: rgba(169, 190, 165, 0.16);
  border-radius: 999rpx;
  font-size: 24rpx;
}

.empty-state {
  margin-top: 56rpx;
  padding: 64rpx 36rpx;
  text-align: center;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 650;
}

.empty-copy {
  margin-top: 16rpx;
  color: var(--color-muted);
  line-height: 1.6;
}
